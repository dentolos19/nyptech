{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nyptech",
  "main": "src/server.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "logpush": true,
  "observability": {
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true
    }
  },
  "route": {
    "pattern": "nyptech.club",
    "custom_domain": true
  },
  "d1_databases": [
    {
      "binding": "DATABASE",
      "database_id": "476a466a-56b2-4fe0-8f43-d4d6c8a5096a"
    }
  ]
}
