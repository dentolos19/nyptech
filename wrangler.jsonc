{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nyptech",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-01",
  "observability": {
    "logs": {
      "enabled": true,
    },
    "traces": {
      "enabled": true,
    },
    "issues": {
      "enabled": true,
    },
  },
  "route": {
    "pattern": "nyptech.club",
    "custom_domain": true,
  },
}
